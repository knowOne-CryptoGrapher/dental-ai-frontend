# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create three recurring Prices in your Stripe Dashboard and paste the IDs here.
# Without these, checkout falls back to one-time payment mode (dev only).
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_ELITE=price_...

# ── Plan gate enforcement ──────────────────────────────────────────────────────
ENFORCE_PLAN_GATES=false
# Set to "true" to enforce subscription plan feature gates on all API endpoints.
# Safe to enable after verifying no existing customers are affected.
# When "false" (default), all plan-gated endpoints are accessible to any
# authenticated user regardless of their practice's subscription tier.

# ── AWS SES (email) ────────────────────────────────────────────────────────────
# IAM user credentials with ses:SendEmail + ses:GetSendQuota permissions.
SES_ACCESS_KEY_ID=AKIA...
SES_SECRET_ACCESS_KEY=<your-secret-access-key>
SES_REGION=ca-central-1
SES_FROM_EMAIL=noreply@frontdeskdentalai.com
SES_FROM_NAME=Front Desk Dental AI
# Create an SNS topic named dental-ai-email-events and paste the ARN here.
# Subscribe https://api.frontdeskdentalai.com/api/webhooks/ses to the topic.
SES_SNS_TOPIC_ARN=arn:aws:sns:ca-central-1:<account-id>:dental-ai-email-events